#!/bin/bash
#PBS -N f0_evaluation
#PBS -l nodes=1:ppn=4:gpus=1
#PBS -l mem=16gb
#PBS -l walltime=2:00:00
#PBS -q pace-ice
#PBS -j oe
#PBS -o evaluation_output.log

# Load modules
module load anaconda3
module load cuda/11.7

# Activate environment
source activate f0_eval

# Navigate to project directory
cd "$PBS_O_WORKDIR"

# Run evaluation
echo "Starting F0 evaluation..."
echo "Date: $(date)"
echo "Hostname: $(hostname)"
echo "GPU: $CUDA_VISIBLE_DEVICES"
echo ""

python evaluate.py

echo ""
echo "Evaluation complete!"
echo "Date: $(date)"
